{
  "schema_version": 1,
  "framework_version": "0.2.0-draft",
  "project_name": "Ableton Agent",
  "default_branch": "main",
  "issue_repository": "Troll-Phace/ableton-agent",
  "commands": {
    "verify": "npm run lint && npm test",
    "tests": "npm test",
    "lint": "npm run lint",
    "format_check": "npm run format:check",
    "dev": "npm start"
  },
  "context_max_chars": 6000,
  "backlog_max_items": 10,
  "backlog_max_age_hours": 24,
  "progress_path": ".claude/state/progress.md"
}
